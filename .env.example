# OpenAI-compatible multimodal chat endpoint.
REWARD_AS_AGENT_API_BASE=http://localhost:7000/v1
REWARD_AS_AGENT_API_KEY=dummy
REWARD_AS_AGENT_MODEL=/path/to/your/reward-model

# Reward service.
REWARD_AS_AGENT_HOST=0.0.0.0
REWARD_AS_AGENT_PORT=7024
REWARD_AS_AGENT_LOG_ROOT=./runs
REWARD_AS_AGENT_SAVE_INPUTS=true
REWARD_AS_AGENT_LLM_TIMEOUT=600
REWARD_AS_AGENT_MAX_RETRIES=10
REWARD_AS_AGENT_PROVIDER=doubao
REWARD_AS_AGENT_MAX_TOKENS=2048
REWARD_AS_AGENT_MAX_INFLIGHT_PER_DP=8
REWARD_AS_AGENT_HEARTBEAT_INTERVAL=30
# Optional; leave unset to use the provider default.
# REWARD_AS_AGENT_TEMPERATURE=0

# Reserved for future non-LLM motion-quality rewards. Currently disabled.
# REWARD_AS_AGENT_ENABLE_MOTION_QUALITY=false
# REWARD_AS_AGENT_MOTION_QUALITY_PATH=

# WMReward is started by scripts/run_wmreward_demo.py, not by `cli serve`.
# Supply --worker-python, --wmreward-repo, --checkpoint, --checkpoint-sha256
# and --device to that runner. See README: WMReward external-tool deployment.
# The worker uses its own CUDA environment; the Agent still needs API credentials.
